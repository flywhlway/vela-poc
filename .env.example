# =========================================================
# VELA 运行期环境变量样例：cp .env.example .env 后按需修改
# 所有变量均可选；未设置时走 config/*.yaml 的默认值
# .env 由 src/vela/config.py 在导入时自动加载（override=False，
# 已存在的进程环境变量优先），无需 source .env 或手工 export
# =========================================================

# ---------- 模型网关（生产接入的唯一开关面）----------
# provider: mock | volcengine | openai_compat
VELA_LLM_PROVIDER=mock

# ---- 火山引擎方舟（Ark）：优先适配 ----
# 控制台创建推理接入点后，把接入点 ID（ep-xxxx）或模型名填到 MODEL
VELA_ARK_API_KEY=
# 合法路径：/api/v3 或 /api/plan/v3（按控制台实际入口选择）
VELA_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VELA_ARK_MODEL=
VELA_ARK_EMBED_MODEL=
# 主接入点失败时的降级接入点（对应 config/llm.yaml fallback_chain）
VELA_ARK_MODEL_FALLBACK=
# 按逻辑模型分别指定接入点；同理可设 _VERIFIER / _REPORTER / _DISTILLER
VELA_ARK_MODEL_PLANNER=

# ---- 任意 OpenAI 兼容端点（vLLM / One-API / 自建网关）----
VELA_OPENAI_API_KEY=
VELA_OPENAI_BASE_URL=
VELA_OPENAI_MODEL=

# ---------- 运行期 ----------
# 产物根目录
VELA_WORKSPACE=./workspace
# poc | production（预算档位）
VELA_PROFILE=poc
# 强制租户谓词的租户标识
VELA_TENANT=demo-tenant
VELA_LOG_LEVEL=INFO
# 确定性要求：固定哈希种子
PYTHONHASHSEED=0
